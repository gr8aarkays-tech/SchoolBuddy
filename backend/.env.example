# SchoolBuddy Backend — environment variables
# Copy this file to .env and fill in your values.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── API Authentication ────────────────────────────────────────────────────────
# A shared secret that the frontend must send as "Authorization: Bearer <secret>".
# Generate a strong random string, e.g.: openssl rand -hex 32
# In development without NODE_ENV=production this check is skipped automatically.
API_SECRET=<generate-a-strong-random-secret>

# ── Database ──────────────────────────────────────────────────────────────────
# Option A — Turso cloud (recommended for production & Render deployments)
#
# Setup:
#   1. Sign up free at https://turso.tech (no credit card needed)
#   2. Install CLI:  curl -sSfL https://get.tur.so/install.sh | bash
#   3. Login:        turso auth login
#   4. Create DB:    turso db create schoolbuddy
#   5. Get URL:      turso db show schoolbuddy --url
#   6. Get token:    turso db tokens create schoolbuddy
#
TURSO_DB_URL=libsql://schoolbuddy-<your-org>.turso.io
TURSO_DB_TOKEN=<your-token-here>

# Option B — Local SQLite file (default when TURSO_DB_URL is not set)
# The file is created automatically at backend/data/sanjuclass1.db
# DATA_DIR=./data
