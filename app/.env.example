# AI Provider configuration
# Copy this file to .env and fill in your values.

# ── Provider selection ────────────────────────────────────────────────────────
# Options: mock | local | openai | anthropic | watsonx
#
# local   — Runs entirely in the browser using WebLLM + WebGPU.
#            No API key needed. Model is downloaded once to the device.
#            Works on Android Chrome 121+ (Jan 2024+) and Chrome/Edge desktop.
#            Users choose and download a model from Settings → Local AI.
#
# mock    — Deterministic fake responses (no API key needed). Default.
# openai  — OpenAI GPT-4o mini. Requires VITE_AI_API_KEY.
# anthropic — Anthropic Claude Haiku. Requires VITE_AI_API_KEY.
# watsonx — IBM watsonx.ai. Requires VITE_WATSONX_* variables below.
#
# Note: in production the provider is set by the user via Settings page
# (stored in localStorage). This env var is only used as a developer fallback.
VITE_AI_PROVIDER=mock

# ── OpenAI (VITE_AI_PROVIDER=openai) ─────────────────────────────────────────
# Get your key at https://platform.openai.com/api-keys
# Used for: text analysis (gpt-4o-mini) + image OCR (gpt-4o-mini vision)
VITE_AI_API_KEY=

# ── Anthropic (VITE_AI_PROVIDER=anthropic) ───────────────────────────────────
# Get your key at https://console.anthropic.com/
# Used for: text analysis (claude-haiku-4-5) + image OCR (claude-haiku-4-5 vision)
# Note: same VITE_AI_API_KEY variable is used for Anthropic as well.
# VITE_AI_API_KEY=sk-ant-...

# ── watsonx.ai (VITE_AI_PROVIDER=watsonx) ────────────────────────────────────
# Text analysis only (no vision/image support).
# VITE_WATSONX_URL=https://us-south.ml.cloud.ibm.com
# VITE_WATSONX_TOKEN=<IAM bearer token>
# VITE_WATSONX_PROJECT_ID=<your project id>
# VITE_WATSONX_MODEL=ibm/granite-3-8b-instruct

# ── Backend API ───────────────────────────────────────────────────────────────
# For production (GitHub Pages → Render):
#   VITE_API_URL = URL of your Render backend, e.g. https://schoolbuddy-backend.onrender.com
#   VITE_API_SECRET = same value as API_SECRET on the backend
VITE_API_URL=
VITE_API_SECRET=

# ── Application ───────────────────────────────────────────────────────────────
VITE_APP_TITLE=AI School Learning Assistant
